<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Library</OutputType>
    <RootNamespace>Wetcon.PactwarePlugin.OpcUaServer</RootNamespace>
    <AssemblyName>Wetcon.PactwarePlugin.OpcUaServer</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <OutputPath>bin\PW6\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>  
  <PropertyGroup Condition="!Exists('..\SolutionInfo.cs')">
    <DefineConstants>FALLBACK_VERSION</DefineConstants>
  </PropertyGroup>  
  <ItemGroup>
    <Compile Remove="OpcUa\Di\latest-v105\**" />
    <Compile Remove="OpcUa\Machinery\**" />
    <Compile Remove="OpcUa\Pumps\**" />
    <EmbeddedResource Remove="OpcUa\Di\latest-v105\**" />
    <EmbeddedResource Remove="OpcUa\Machinery\**" />
    <EmbeddedResource Remove="OpcUa\Pumps\**" />
    <None Remove="OpcUa\Di\latest-v105\**" />
    <None Remove="OpcUa\Machinery\**" />
    <None Remove="OpcUa\Pumps\**" />
  </ItemGroup>  
  <ItemGroup>
    <None Remove="OpcUa\Di\Opc.Ua.Di.NodeSet2.xml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Jigfdt.fdt100">
      <HintPath>lib\Jigfdt.fdt100.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>lib\log4net.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PWID">
      <HintPath>lib\pw6\PWID.dll</HintPath>
    </Reference>
    <Reference Include="PWUtil5">
      <HintPath>lib\pw6\PWUTIL5.DLL</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Xml.Serialization" />
    <Reference Include="Wetcon.IoLink.Helper">
      <HintPath>lib\Wetcon.IoLink.Helper.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SolutionInfo.cs">
      <Link>Properties\SolutionInfo.cs</Link>
    </Compile>
    <Compile Update="UserControls\AboutUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\BaseUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\OptionsUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="WetconOpcUaServer.Config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\wetconIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="OpcUa\Di\Opc.Ua.Di.NodeSet2.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua">
      <Version>1.5.378.152</Version>
    </PackageReference>
    <PackageReference Include="System.Reactive">
      <Version>6.1.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="lib\pw6\PWID.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="lib\pw6\PWUTIL5.DLL">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>REM powershell -command "Start-Process $(ProjectDir)Wetcon.PactwarePlugin.OpcUaServer_x64.bat -Verb runas"</PostBuildEvent>
  </PropertyGroup>
</Project>
