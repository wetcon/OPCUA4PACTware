  <opc:StructuredType Name="PhysicalAddressDataType" BaseType="ua:ExtensionObject">
    <opc:Documentation>Physical address of the manufacturer.</opc:Documentation>
    <opc:Field Name="Street" TypeName="ua:LocalizedText" />
    <opc:Field Name="Number" TypeName="ua:LocalizedText" />
    <opc:Field Name="City" TypeName="ua:LocalizedText" />
